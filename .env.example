# ---------------------------------------------------------------------------
# AI for 6G Learning Platform — environment
# Copy to .env.local (git-ignored). Vite reads these at BUILD time.
# ---------------------------------------------------------------------------

# NOTE: GEMINI_API_KEY was removed. The previous build injected it into the
# client bundle via vite.config.ts, but no source file ever read it — so a key
# was being published to every visitor for no functional reason. If AI features
# are added, call them from a server-side endpoint instead.

# Deployment label, surfaced in diagnostics.
VITE_APP_ENV=production

# Workshop demo credentials. These are NOT secrets: anything prefixed with VITE_
# is compiled into the public bundle, and the login screen displays them anyway.
# Real access control is the central lab authorization gate below.
VITE_DEMO_USER=demo_user
VITE_DEMO_PASSWORD=demo123

# --- Central lab authorization ---------------------------------------------
# Defaults: enabled in production builds, disabled in dev so `npm run dev` works.
# VITE_LAB_AUTH_ENABLED=true
# VITE_LAB_AUTH_VERIFY_URL=https://live-labs.org/api/auth/authorize-lab
# VITE_LAB_LOGIN_URL=https://live-labs.org/login
# VITE_LAB_HOME_URL=https://live-labs.org/labs
# VITE_LAB_AUTH_REVALIDATE_MS=900000

# --- 6G Network Copilot (spec §8) ------------------------------------------
# The assistant has exactly one transport: a server-side gateway. No model
# vendor SDK is bundled and no provider key is read here, because anything
# prefixed with VITE_ is compiled into the public bundle and is therefore
# published. Leave this unset and the Copilot is ABSENT rather than faked — the
# panel falls back to the simulation engine's own reading of its own numbers,
# clearly labelled as such.
#
# Gateway contract:
#   POST {VITE_LLM_PROXY_URL}/generate
#   → { model, prompt, systemInstruction, temperature }
#   ← 200 { "text": "..." }
#
# Requests are sent with credentials, so the gateway must answer the preflight
# with an explicit Access-Control-Allow-Origin for this lab's origin. A wildcard
# is rejected by the browser when credentials are included, and the rejection
# leaves no entry in the gateway's log.
# NOTE: if this is a DIFFERENT ORIGIN from the lab itself, you must also allow
# it in the Content-Security-Policy (nginx-security-headers.conf) or the browser
# blocks the request before it is sent — with no Network-tab entry, only a
# Console violation. Proxying the gateway under this origin and setting
# VITE_LLM_PROXY_URL=/llm avoids the problem entirely; nginx.conf has a
# commented example.
# VITE_LLM_PROXY_URL=https://gateway.example.org/llm
# VITE_LLM_MODEL=claude-sonnet-5
# VITE_LLM_TIMEOUT_MS=30000
