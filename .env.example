# ---------------------------------------------------------------------------
# AI for 6G Learning Platform — environment
# Copy to .env.local (git-ignored). Vite reads these at BUILD time.
# ---------------------------------------------------------------------------

# NOTE: GEMINI_API_KEY was removed. The previous build injected it into the
# client bundle via vite.config.ts, but no source file ever read it — so a key
# was being published to every visitor for no functional reason. If AI features
# are added, call them from a server-side endpoint instead.

# Deployment label, surfaced in diagnostics.
VITE_APP_ENV=production

# Workshop demo credentials. These are NOT secrets: anything prefixed with VITE_
# is compiled into the public bundle, and the login screen displays them anyway.
# Real access control is the central lab authorization gate below.
VITE_DEMO_USER=demo_user
VITE_DEMO_PASSWORD=demo123

# --- Central lab authorization ---------------------------------------------
# Defaults: enabled in production builds, disabled in dev so `npm run dev` works.
# VITE_LAB_AUTH_ENABLED=true
# VITE_LAB_AUTH_VERIFY_URL=https://live-labs.org/api/auth/authorize-lab
# VITE_LAB_LOGIN_URL=https://live-labs.org/login
# VITE_LAB_HOME_URL=https://live-labs.org/labs
# VITE_LAB_AUTH_REVALIDATE_MS=900000
